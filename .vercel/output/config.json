{
	"version": 3,
	"routes": [
		{
			"src": "^/(.*)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/_image$",
			"dest": "_render"
		},
		{
			"src": "^/api/arajanlat/catalog$",
			"dest": "_render"
		},
		{
			"src": "^/api/arajanlat/preview$",
			"dest": "_render"
		},
		{
			"src": "^/api/arajanlat/quotes$",
			"dest": "_render"
		},
		{
			"src": "^/arajanlat/ajanlat/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/arajanlat/katalogus$",
			"dest": "_render"
		},
		{
			"src": "^/arajanlat/lista$",
			"dest": "_render"
		},
		{
			"src": "^/arajanlat$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}