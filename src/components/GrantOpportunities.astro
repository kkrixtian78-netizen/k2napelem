---
const steps = [
  { when: '2026. jan. 15.', label: 'Felhívás', state: 'soon' as const },
  { when: '2026. feb.–márc.', label: 'Benyújtás', state: 'focus' as const },
  { when: '2026. máj. vége', label: 'Döntés', state: 'later' as const },
  { when: 'max. 24 hónap', label: 'Megvalósítás', state: 'later' as const },
];

const faq = [
  {
    q: 'Kell-e saját erő a támogatáshoz?',
    a: 'Igen — a támogatás a beruházás egy részét fedezi (max. 2 500 000 Ft). A fennmaradó saját erőt és a pontos elszámolást a hivatalos felhívás szerint kell tervezni.',
  },
  {
    q: 'Mi van, ha elutasítják a pályázatot?',
    a: 'Átnézzük az indoklást, és megmondjuk, érdemes-e javítani / újra benyújtani, vagy inkább piaci kivitelezésben gondolkodni. Nem hagyjuk magára a folyamat közben.',
  },
  {
    q: 'Meddig kell megvalósítani?',
    a: 'A támogatói okirat után jellemzően legfeljebb 24 hónap áll rendelkezésre. A határidőket a hivatalos felhívás rögzíti.',
  },
  {
    q: 'Mi a különbség a pályázatírás és a kivitelezés között?',
    a: 'A pályázatírás a dokumentumok és a benyújtás; a kivitelezés a napelem / tároló tényleges telepítése. Nálunk mindkettő egy kézben lehet — így kevesebb a félreértés.',
  },
];
---

<article
  id="palyazat"
  class="scroll-mt-24 rounded-2xl border border-[var(--color-line)] bg-white/80 p-6 sm:p-8 lg:p-10"
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Pályázati lehetőségek</h2>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Otthoni Energiatároló Program — most érdemes előkészíteni a papírokat, hogy a benyújtási ablaknyitáskor ne csússzon el a lehetőség.
      </p>
    </div>
    <p class="font-display text-3xl font-bold text-[var(--color-sun-deep)] sm:text-4xl">
      2,5&nbsp;M&nbsp;Ft
      <span class="mt-1 block text-sm font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-soft)]">
        max. vissza nem térítendő
      </span>
    </p>
  </div>

  <!-- Timeline -->
  <ol class="mt-10 grid gap-4 sm:grid-cols-4">
    {
      steps.map((s) => (
        <li
          class:list={[
            'border-t-2 pt-3',
            s.state === 'focus' ? 'border-[var(--color-sun)]' : 'border-[var(--color-line)]',
          ]}
        >
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">{s.when}</p>
          <p class="mt-1 font-display text-lg font-bold">{s.label}</p>
          {s.state === 'focus' && (
            <p class="mt-1 text-xs font-semibold text-[var(--color-sun-deep)]">Aktuális fókusz: előkészítés</p>
          )}
        </li>
      ))
    }
  </ol>

  <div class="mt-10 grid gap-10 lg:grid-cols-2">
    <!-- Screener -->
    <div>
      <h3 class="font-display text-xl font-bold">Érdemes-e nekem?</h3>
      <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Négy gyors kérdés — tájékoztató jellegű, nem hivatalos előminősítés.</p>
      <form class="mt-5 space-y-4" data-grant-screener>
        <fieldset class="space-y-2">
          <legend class="text-sm font-medium">Van már napelemes rendszere, vagy tervezi a telepítését?</legend>
          <div class="flex flex-wrap gap-3 text-sm">
            <label class="inline-flex items-center gap-2"><input type="radio" name="solar" value="yes" required /> Igen</label>
            <label class="inline-flex items-center gap-2"><input type="radio" name="solar" value="no" /> Nem</label>
          </div>
        </fieldset>
        <fieldset class="space-y-2">
          <legend class="text-sm font-medium">Érdekli a legalább ~10 kWh lakossági energiatároló?</legend>
          <div class="flex flex-wrap gap-3 text-sm">
            <label class="inline-flex items-center gap-2"><input type="radio" name="storage" value="yes" required /> Igen</label>
            <label class="inline-flex items-center gap-2"><input type="radio" name="storage" value="no" /> Nem / nem tudom</label>
          </div>
        </fieldset>
        <fieldset class="space-y-2">
          <legend class="text-sm font-medium">5000 fő alatti településen él?</legend>
          <div class="flex flex-wrap gap-3 text-sm">
            <label class="inline-flex items-center gap-2"><input type="radio" name="smallTown" value="yes" required /> Igen</label>
            <label class="inline-flex items-center gap-2"><input type="radio" name="smallTown" value="no" /> Nem</label>
          </div>
        </fieldset>
        <fieldset class="space-y-2">
          <legend class="text-sm font-medium">Szaldós elszámolásból kikerült / kikerül?</legend>
          <div class="flex flex-wrap gap-3 text-sm">
            <label class="inline-flex items-center gap-2"><input type="radio" name="saldo" value="yes" required /> Igen</label>
            <label class="inline-flex items-center gap-2"><input type="radio" name="saldo" value="no" /> Nem / nem tudom</label>
          </div>
        </fieldset>
        <button
          type="submit"
          class="rounded-md bg-[var(--color-sun)] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[var(--color-sun-deep)]"
        >
          Eredmény megtekintése
        </button>
      </form>
      <div
        class="mt-4 hidden rounded-md border border-[var(--color-line)] bg-[var(--color-mist)]/50 px-4 py-3 text-sm"
        data-grant-result
        hidden
        role="status"
      ></div>
    </div>

    <!-- What you get + example -->
    <div class="space-y-8">
      <div>
        <h3 class="font-display text-xl font-bold">Mit kap tőlünk?</h3>
        <ol class="mt-4 space-y-3 text-sm text-[var(--color-ink-soft)]">
          <li><span class="font-semibold text-[var(--color-ink)]">1. Előminősítés</span> — átnézzük, reális-e a program az Ön helyzetére.</li>
          <li><span class="font-semibold text-[var(--color-ink)]">2. Dokumentumlista</span> — mit kell összegyűjteni a benyújtáshoz.</li>
          <li><span class="font-semibold text-[var(--color-ink)]">3. Pályázatírás</span> — előkészítéstől a benyújtásig.</li>
          <li><span class="font-semibold text-[var(--color-ink)]">4. Kivitelezés + zárás</span> — telepítés és a záró dokumentumok egy kézben.</li>
        </ol>
      </div>
      <div>
        <h3 class="font-display text-xl font-bold">Számpélda (tájékoztató)</h3>
        <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
          Egy ~10&nbsp;kWh otthoni tárolós beruházás bruttó költsége gyakran több millió forint.
          A program keretében <strong class="text-[var(--color-ink)]">akár 2&nbsp;500&nbsp;000&nbsp;Ft</strong> vissza nem térítendő
          támogatás csökkentheti a saját erőt — a pontos összeg a hivatalos feltételektől és az Ön rendszerétől függ.
        </p>
        <p class="mt-2 text-xs text-[var(--color-ink-soft)]">
          Ez nem árajánlat. Személyre szabott számot felmérés után adunk.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="mt-10 border-t border-[var(--color-line)] pt-8">
    <h3 class="font-display text-xl font-bold">Gyakori kérdések</h3>
    <div class="mt-4 divide-y divide-[var(--color-line)]">
      {
        faq.map((item) => (
          <details class="group py-3">
            <summary class="cursor-pointer list-none font-display text-base font-bold marker:content-none">
              {item.q}
            </summary>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href="/otthoni-energiatarolo"
      class="rounded-md bg-[var(--color-sun)] px-5 py-3 text-sm font-semibold text-white no-underline transition hover:bg-[var(--color-sun-deep)]"
    >
      Program részletei
    </a>
    <a
      href="/kapcsolat#ajanlat"
      class="rounded-md border border-[var(--color-line)] bg-white px-5 py-3 text-sm font-semibold no-underline transition hover:bg-[var(--color-mist)]"
    >
      Érdekel, keressetek
    </a>
    <a href="/palyazatiras" class="self-center text-sm font-semibold text-[var(--color-sky-deep)]">
      Pályázatírás szolgáltatás →
    </a>
  </div>
</article>

<script>
  const form = document.querySelector('[data-grant-screener]');
  const result = document.querySelector('[data-grant-result]');
  if (form instanceof HTMLFormElement && result instanceof HTMLElement) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const solar = data.get('solar');
      const storage = data.get('storage');
      const smallTown = data.get('smallTown');
      const saldo = data.get('saldo');

      let html = '';
      if (solar === 'yes' && storage === 'yes') {
        const boosts = [];
        if (smallTown === 'yes') boosts.push('kisebb település');
        if (saldo === 'yes') boosts.push('szaldóból kikerülés');
        html =
          '<p class="font-semibold text-[var(--color-ink)]">Valószínűleg érdemes egyeztetni.</p>' +
          '<p class="mt-1 text-[var(--color-ink-soft)]">Van (vagy lesz) napelem, és érdeklődik a tároló iránt' +
          (boosts.length ? ` — plusz előny lehet: ${boosts.join(', ')}` : '') +
          '. Nézzük át együtt a pontos feltételeket.</p>';
      } else if (storage === 'no' && solar === 'no') {
        html =
          '<p class="font-semibold text-[var(--color-ink)]">Most ez a program kevésbé illik.</p>' +
          '<p class="mt-1 text-[var(--color-ink-soft)]">Ha később napelemben és tárolóban gondolkodik, szívesen tervezünk előre — vagy nézzük meg a piaci kivitelezési lehetőségeket.</p>';
      } else {
        html =
          '<p class="font-semibold text-[var(--color-ink)]">Egyeztessünk — nem egyértelmű a kép.</p>' +
          '<p class="mt-1 text-[var(--color-ink-soft)]">A válaszai vegyesek. Rövid beszélgetéssel kiderül, érdemes-e a programra készülni, vagy más megoldás a jobb.</p>';
      }

      result.innerHTML =
        html +
        '<p class="mt-3"><a class="font-semibold text-[var(--color-sky-deep)]" href="/kapcsolat#ajanlat">Árajánlat / visszahívás →</a></p>';
      result.hidden = false;
      result.classList.remove('hidden');
    });
  }
</script>
