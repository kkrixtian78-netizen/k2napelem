---
import { site } from '../data/site';
const gtmId = site.gtmId;
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-[var(--color-line)] bg-white/95 p-4 shadow-[0_-8px_30px_rgba(28,42,48,0.08)] backdrop-blur md:p-5"
  hidden
  role="dialog"
  aria-labelledby="cookie-title"
  aria-live="polite"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div class="max-w-3xl">
      <p id="cookie-title" class="font-display text-lg font-bold text-[var(--color-ink)]">Sütik és mérés</p>
      <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
        A weboldal működéséhez szükséges technológiákat használunk. A látogatottsági statisztikához (Google Tag Manager)
        az Ön hozzájárulása kell. Részletek:
        <a href="/sutik" class="font-semibold text-[var(--color-sky-deep)]">süti tájékoztató</a>,
        <a href="/adatvedelem" class="font-semibold text-[var(--color-sky-deep)]">adatvédelem</a>.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        class="rounded-md border border-[var(--color-line)] bg-white px-4 py-2.5 text-sm font-semibold"
        data-cookie-reject
      >
        Csak szükséges
      </button>
      <button
        type="button"
        class="rounded-md bg-[var(--color-sun)] px-4 py-2.5 text-sm font-semibold text-white"
        data-cookie-accept
      >
        Elfogadom
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gtmId }}>
  (function () {
    var KEY = 'k2-cookie-consent';
    var banner = document.getElementById('cookie-banner');

    function loadGtm() {
      if (!gtmId || window.__k2GtmLoaded) return;
      window.__k2GtmLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = document.getElementsByTagName('script')[0];
      var j = document.createElement('script');
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      f.parentNode.insertBefore(j, f);
    }

    function hide() {
      if (!banner) return;
      banner.setAttribute('hidden', '');
      banner.classList.add('hidden');
    }

    function show() {
      if (!banner) return;
      banner.removeAttribute('hidden');
      banner.classList.remove('hidden');
    }

    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }

    function write(v) {
      try {
        localStorage.setItem(KEY, v);
      } catch (e) {}
    }

    var current = read();
    if (current === 'accepted') {
      loadGtm();
      hide();
    } else if (current === 'rejected') {
      hide();
    } else {
      show();
    }

    document.querySelector('[data-cookie-accept]')?.addEventListener('click', function () {
      write('accepted');
      loadGtm();
      hide();
    });
    document.querySelector('[data-cookie-reject]')?.addEventListener('click', function () {
      write('rejected');
      hide();
    });
  })();
</script>
