---
import { formatProductPrice, products, type Product } from '../data/products';

interface Props {
  items?: Product[];
  showFilters?: boolean;
}

const { items = products, showFilters = true } = Astro.props;

const categories = [
  { id: 'napelem' as const, label: 'Napelemes rendszerhez' },
  { id: 'ev' as const, label: 'EV töltők' },
  { id: 'futes' as const, label: 'Elektromos fűtés' },
];

const sections = categories
  .map((c) => ({ ...c, items: items.filter((p) => p.category === c.id) }))
  .filter((s) => s.items.length > 0);

const defaultCat = sections[0]?.id ?? 'napelem';
---

<div data-shop data-default-cat={defaultCat}>
  {
    showFilters && (
      <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Kategóriák">
        {sections.map((s) => (
          <button
            type="button"
            class:list={[
              'rounded-md border px-3 py-2 text-sm font-semibold',
              s.id === defaultCat
                ? 'border-[var(--color-ink)] bg-[var(--color-ink)] text-white'
                : 'border-[var(--color-line)] bg-white/70',
            ]}
            data-filter={s.id}
            aria-selected={s.id === defaultCat ? 'true' : 'false'}
          >
            {s.label}
          </button>
        ))}
      </div>
    )
  }

  {
    sections.map((s) => (
      <section
        class="mb-4"
        data-category-section={s.id}
        hidden={showFilters && s.id !== defaultCat}
      >
        {!showFilters && (
          <h2 class="mb-6 font-display text-2xl font-bold">{s.label}</h2>
        )}
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {s.items.map((p) => (
            <li class="flex flex-col" data-product-card data-category={p.category}>
              <a href={`/bolt/${p.slug}`} class="group block no-underline">
                <div class="overflow-hidden rounded-xl bg-white/50">
                  <img
                    src={p.image}
                    alt={p.name}
                    class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>
                <h2 class="mt-4 font-display text-xl font-bold">{p.name}</h2>
                <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{p.short}</p>
                <p class="mt-3 text-sm font-semibold leading-snug">
                  {formatProductPrice(p.priceFrom, p.priceTo)}
                </p>
              </a>
              <button
                type="button"
                class="mt-4 inline-flex w-fit rounded-md border border-[var(--color-line)] bg-white/80 px-3 py-2 text-sm font-semibold transition hover:border-[var(--color-sky-deep)]"
                data-add-to-inquiry
                data-id={p.id}
                data-name={p.name}
                data-price={p.priceFrom}
              >
                Érdeklődéshez adom
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="fixed bottom-20 right-4 z-40 flex max-w-[calc(100vw-2rem)] flex-col items-end gap-3 md:bottom-4" data-inquiry-root>
    <div
      class="hidden w-[min(22rem,calc(100vw-2rem))] rounded-xl border border-[var(--color-line)] bg-white p-4"
      data-inquiry-panel
      hidden
    >
      <div class="flex items-center justify-between gap-3">
        <p class="font-display text-lg font-bold">Érdeklődési lista</p>
        <button type="button" class="text-sm font-semibold text-[var(--color-ink-soft)]" data-inquiry-close>Bezár</button>
      </div>
      <ul class="mt-3 max-h-56 space-y-2 overflow-auto text-sm" data-inquiry-list></ul>
      <p class="mt-3 text-sm font-semibold" data-inquiry-total></p>
      <button
        type="button"
        class="mt-4 w-full rounded-md bg-[var(--color-sun)] px-3 py-2.5 text-sm font-semibold text-white"
        data-inquiry-send
      >
        Küldés e-mailben
      </button>
      <p class="mt-2 text-xs text-[var(--color-ink-soft)]">
        Egyszerű webshop: nincs online fizetés. Az érdeklődést e-mailben kapjuk, visszahívunk.
      </p>
    </div>
    <button type="button" class="rounded-md bg-[var(--color-ink)] px-4 py-3 text-sm font-semibold text-white" data-inquiry-toggle>
      Lista (<span data-inquiry-count>0</span>)
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'k2-inquiry-cart';
    var shop = document.querySelector('[data-shop]');
    function read() {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; }
    }
    function write(items) { localStorage.setItem(KEY, JSON.stringify(items)); }
    function fmt(n) {
      return new Intl.NumberFormat('hu-HU', { style: 'currency', currency: 'HUF', maximumFractionDigits: 0 }).format(n);
    }
    function fmtNetVat(n) {
      var gross = Math.round(n * 1.27);
      return fmt(n) + ' + ÁFA (' + fmt(gross) + ')';
    }
    function setCategory(cat) {
      if (!shop) return;
      shop.querySelectorAll('[data-filter]').forEach(function (b) {
        var active = b.getAttribute('data-filter') === cat;
        b.classList.toggle('bg-[var(--color-ink)]', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-[var(--color-ink)]', active);
        b.classList.toggle('bg-white/70', !active);
        b.classList.toggle('border-[var(--color-line)]', !active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      shop.querySelectorAll('[data-category-section]').forEach(function (sec) {
        if (sec.getAttribute('data-category-section') === cat) {
          sec.removeAttribute('hidden');
        } else {
          sec.setAttribute('hidden', '');
        }
      });
    }
    function render() {
      var items = read();
      var count = items.reduce(function (s, i) { return s + i.qty; }, 0);
      var sum = items.reduce(function (s, i) { return s + i.price * i.qty; }, 0);
      document.querySelectorAll('[data-inquiry-count]').forEach(function (el) { el.textContent = String(count); });
      document.querySelectorAll('[data-inquiry-total]').forEach(function (el) {
        el.textContent = count ? 'Összesen nettó (tájékoztató): ' + fmtNetVat(sum) : '';
      });
      document.querySelectorAll('[data-inquiry-list]').forEach(function (list) {
        list.innerHTML = items.length
          ? items.map(function (i) {
              return '<li class="flex items-start justify-between gap-3 border-b border-[var(--color-line)] pb-2"><span>' +
                i.qty + '× ' + i.name +
                '</span><button type="button" data-remove="' + i.id +
                '" class="text-xs font-semibold text-[var(--color-sun-deep)]">törlés</button></li>';
            }).join('')
          : '<li class="text-[var(--color-ink-soft)]">A lista üres.</li>';
      });
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;
      var addBtn = t.closest('[data-add-to-inquiry]');
      if (addBtn) {
        var items = read();
        var id = addBtn.getAttribute('data-id') || '';
        var existing = items.find(function (i) { return i.id === id; });
        if (existing) existing.qty += 1;
        else items.push({
          id: id,
          name: addBtn.getAttribute('data-name') || '',
          price: Number(addBtn.getAttribute('data-price') || 0),
          qty: 1
        });
        write(items);
        render();
        document.querySelectorAll('[data-inquiry-panel]').forEach(function (p) {
          p.classList.remove('hidden');
          p.removeAttribute('hidden');
        });
        return;
      }
      if (t.closest('[data-inquiry-toggle]')) {
        document.querySelectorAll('[data-inquiry-panel]').forEach(function (p) {
          if (p.hasAttribute('hidden')) {
            p.removeAttribute('hidden');
            p.classList.remove('hidden');
          } else {
            p.setAttribute('hidden', '');
            p.classList.add('hidden');
          }
        });
        return;
      }
      if (t.closest('[data-inquiry-close]')) {
        document.querySelectorAll('[data-inquiry-panel]').forEach(function (p) {
          p.setAttribute('hidden', '');
          p.classList.add('hidden');
        });
        return;
      }
      var remove = t.closest('[data-remove]');
      if (remove) {
        var rid = remove.getAttribute('data-remove');
        write(read().filter(function (i) { return i.id !== rid; }));
        render();
        return;
      }
      if (t.closest('[data-inquiry-send]')) {
        var cart = read();
        if (!cart.length) return;
        var body = ['Érdeklődés a K2Napelem boltból (nettó árak + ÁFA):', '']
          .concat(cart.map(function (i) { return '- ' + i.qty + '× ' + i.name + ' (nettó tájékoztató: ' + fmtNetVat(i.price) + '/egység)'; }))
          .concat(['', 'Összesen nettó (tájékoztató): ' + fmtNetVat(cart.reduce(function (s, i) { return s + i.price * i.qty; }, 0)), '', 'Kérem, visszahívást / árajánlatot.'])
          .join('\n');
        window.location.href = 'mailto:k2@k2napelem.hu?subject=' +
          encodeURIComponent('Bolt érdeklődés — k2napelem.hu') +
          '&body=' + encodeURIComponent(body);
        return;
      }
      var filterBtn = t.closest('[data-filter]');
      if (filterBtn && shop) {
        setCategory(filterBtn.getAttribute('data-filter') || shop.getAttribute('data-default-cat') || 'napelem');
      }
    });

    if (shop) {
      setCategory(shop.getAttribute('data-default-cat') || 'napelem');
    }
    render();
  })();
</script>
