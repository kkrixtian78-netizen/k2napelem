---
import { site } from '../data/site';
---

<div class="fixed inset-x-0 bottom-0 z-30 border-t border-[var(--color-line)] bg-white/95 p-3 backdrop-blur md:hidden">
  <div class="mx-auto flex max-w-6xl gap-2">
    <a
      href={site.phoneHref}
      class="flex-1 rounded-md border border-[var(--color-line)] px-3 py-3 text-center text-sm font-semibold no-underline"
    >
      Hívás
    </a>
    <a
      href="/kapcsolat#ajanlat"
      class="flex-[1.4] rounded-md bg-[var(--color-sun)] px-3 py-3 text-center text-sm font-semibold text-white no-underline"
    >
      Árajánlat
    </a>
  </div>
</div>
