---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-8 pt-14 sm:px-6">
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-sky-deep)]">{eyebrow}</p>
  )}
  <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">{title}</h1>
  {lead && <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">{lead}</p>}
</section>
