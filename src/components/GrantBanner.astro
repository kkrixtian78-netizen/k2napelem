---
/**
 * Pályázati státusz — manuálisan frissítendő.
 * status: 'open' | 'upcoming' | 'closed'
 */
const status = 'upcoming' as 'open' | 'upcoming' | 'closed';

const copy = {
  open: {
    label: 'Aktuális',
    text: 'Pályázati lehetőségek: OETP igazolási szakasz és Wekerle+ energetikai felújítás — segítünk az eligazodásban.',
  },
  upcoming: {
    label: 'Figyelem',
    text: 'OETP: igazolási szakasz a megfelelt pályázóknak. Wekerle+ Családi Ház Program: várhatóan 2027. február.',
  },
  closed: {
    label: 'Zárva',
    text: 'Az aktuális pályázati ablak zárva van. Írjon nekünk — jelezzük a következő lehetőségeket.',
  },
}[status];
---

<aside class="border-b border-[var(--color-line)] bg-[color-mix(in_oklab,var(--color-sun)_12%,white)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="text-sm text-[var(--color-ink)]">
      <span class="mr-2 inline-flex rounded-md bg-[var(--color-sun)] px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-white">
        {copy.label}
      </span>
      {copy.text}
    </p>
    <a
      href="/palyazati-lehetosegek"
      class="shrink-0 text-sm font-semibold text-[var(--color-sun-deep)] no-underline"
    >
      Pályázati lehetőségek →
    </a>
  </div>
</aside>
