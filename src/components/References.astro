---
import { references } from '../data/site';
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="referenciak-cim">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-sky-deep)]">Referenciák</p>
    <h2 id="referenciak-cim" class="mt-2 font-display text-3xl font-bold sm:text-4xl">
      Rövid példák számokkal
    </h2>
    <p class="mt-3 text-[var(--color-ink-soft)]">
      Valós kivitelezéseinkből — tájékoztató jelleggel. A pontos méret és ár mindig felmérés után alakul.
    </p>
  </div>

  <ul class="mt-10 grid gap-8 md:grid-cols-3">
    {
      references.map((ref) => (
        <li class="border-t border-[var(--color-line)] pt-5">
          <h3 class="font-display text-xl font-bold">{ref.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{ref.place}</p>
          <dl class="mt-5 space-y-2">
            {ref.stats.map((s) => (
              <div class="flex items-baseline justify-between gap-3 text-sm">
                <dt class="text-[var(--color-ink-soft)]">{s.label}</dt>
                <dd class="font-semibold tabular-nums text-[var(--color-ink)]">{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 text-sm text-[var(--color-ink-soft)]">{ref.note}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 text-sm">
    <a href="/munkaink" class="font-semibold text-[var(--color-sky-deep)]">Saját munkáink galériája →</a>
  </p>
</section>
