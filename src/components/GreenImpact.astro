---
/**
 * Zöld hatás — a jelenlegi flotta napi ~3000 kWh termeléséből.
 *
 * Induló összeg (ma): lineáris kapacitásnövekedés 15 év alatt 0 → mai ütem,
 * azaz átlagosan a mai termelés fele → ~8 218 MWh kumulált energia.
 * Ettől a referencianaptól a számláló napi 3000 kWh ütemmel nő.
 *
 * CO₂: 0,35 kg/kWh · faegyenérték: ~21 kg CO₂/év/fa
 */
const DAILY_KWH = 3000;
const CO2_KG_PER_KWH = 0.35;
const TREE_KG_CO2_PER_YEAR = 21;
/** Referencia: ettől a naptól számítjuk a további napi növekedést */
const BASE_ISO = '2026-11-11T12:00:00+01:00';
/** Kumulált kWh a BASE_ISO pillanatában (15 év lineáris növekedés modell) */
const BASE_KWH = Math.round(DAILY_KWH * 365.25 * 15 * 0.5);
---

<section
  class="border-y border-[var(--color-line)] bg-[color-mix(in_oklab,var(--color-leaf)_8%,white)]"
  data-green-impact
  data-daily={DAILY_KWH}
  data-co2={CO2_KG_PER_KWH}
  data-tree={TREE_KG_CO2_PER_YEAR}
  data-base-iso={BASE_ISO}
  data-base-kwh={BASE_KWH}
  aria-label="Zöld hatás"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-leaf)]">Zöld hatás</p>
    <h3 class="mt-2 max-w-2xl font-display text-2xl font-bold sm:text-3xl">
      Amit együtt termelünk a Nappal
    </h3>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-soft)]">
      A mostanáig üzembe helyezett rendszereink kb. {DAILY_KWH.toLocaleString('hu-HU')}&nbsp;kWh-t termelnek naponta —
      az összesített hatás folyamatosan nő.
    </p>

    <dl class="mt-10 grid gap-8 sm:grid-cols-3">
      <div class="border-t border-[color-mix(in_oklab,var(--color-leaf)_28%,var(--color-line))] pt-5">
        <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Megtermelt energia</dt>
        <dd class="mt-2 font-display text-3xl font-bold tabular-nums text-[var(--color-leaf)] sm:text-4xl">
          <span data-count="mwh">0</span>
          <span class="text-xl font-semibold sm:text-2xl"> MWh</span>
        </dd>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">tiszta áram a napból</p>
      </div>
      <div class="border-t border-[color-mix(in_oklab,var(--color-leaf)_28%,var(--color-line))] pt-5">
        <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Elkerült CO₂</dt>
        <dd class="mt-2 font-display text-3xl font-bold tabular-nums text-[var(--color-leaf)] sm:text-4xl">
          <span data-count="co2">0</span>
          <span class="text-xl font-semibold sm:text-2xl"> t</span>
        </dd>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">kevesebb szén-dioxid a levegőben</p>
      </div>
      <div class="border-t border-[color-mix(in_oklab,var(--color-leaf)_28%,var(--color-line))] pt-5">
        <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Faegyenérték</dt>
        <dd class="mt-2 font-display text-3xl font-bold tabular-nums text-[var(--color-leaf)] sm:text-4xl">
          <span data-count="trees">0</span>
          <span class="text-xl font-semibold sm:text-2xl"> fa</span>
        </dd>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">éves CO₂-elnyelésnek megfelel</p>
      </div>
    </dl>
  </div>
</section>

<script>
  function formatHu(n: number, digits = 0): string {
    return new Intl.NumberFormat('hu-HU', {
      maximumFractionDigits: digits,
      minimumFractionDigits: digits,
    }).format(n);
  }

  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function computeImpact(root: HTMLElement) {
    const daily = Number(root.dataset.daily);
    const co2PerKwh = Number(root.dataset.co2);
    const treeKg = Number(root.dataset.tree);
    const baseKwh = Number(root.dataset.baseKwh);
    const baseMs = Date.parse(root.dataset.baseIso || '');
    const daysElapsed = Math.max(0, (Date.now() - baseMs) / 86_400_000);
    const kwh = baseKwh + daysElapsed * daily;
    const co2Kg = kwh * co2PerKwh;
    return {
      mwh: kwh / 1000,
      co2T: co2Kg / 1000,
      trees: co2Kg / treeKg,
    };
  }

  function mount(root: HTMLElement) {
    const elMwh = root.querySelector<HTMLElement>('[data-count="mwh"]');
    const elCo2 = root.querySelector<HTMLElement>('[data-count="co2"]');
    const elTrees = root.querySelector<HTMLElement>('[data-count="trees"]');
    if (!elMwh || !elCo2 || !elTrees) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let animated = false;
    let base = computeImpact(root);
    let display = { mwh: 0, co2T: 0, trees: 0 };

    const paint = () => {
      elMwh.textContent = formatHu(display.mwh, display.mwh >= 1000 ? 0 : 1);
      elCo2.textContent = formatHu(display.co2T, display.co2T >= 1000 ? 0 : 1);
      elTrees.textContent = formatHu(Math.round(display.trees));
    };

    const startLive = () => {
      setInterval(() => {
        base = computeImpact(root);
        display = { ...base };
        paint();
      }, 2000);
    };

    const runIntro = () => {
      if (animated) return;
      animated = true;
      base = computeImpact(root);
      if (reduced) {
        display = { ...base };
        paint();
        startLive();
        return;
      }
      const duration = 1600;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const e = easeOutCubic(t);
        display = {
          mwh: base.mwh * e,
          co2T: base.co2T * e,
          trees: base.trees * e,
        };
        paint();
        if (t < 1) requestAnimationFrame(tick);
        else startLive();
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            runIntro();
            io.disconnect();
            break;
          }
        }
      },
      { threshold: 0.35 },
    );
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-green-impact]').forEach(mount);
</script>
