---
const quotes = [
  {
    text: 'Több száz lakossági rendszer után is ugyanaz a cél: hiba nélküli átadás és továbbajánlás.',
    who: 'Kántor Krisztián',
    role: 'K2Napelem',
  },
  {
    text: 'Felméréstől a készre jelentésig egy kézben — saját fotókkal a saját munkáinkról.',
    who: 'Csapat',
    role: 'Kivitelezés',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <h2 class="font-display text-3xl font-bold sm:text-4xl">Bizalom, nem sablonbeszéd</h2>
  <p class="mt-3 max-w-2xl text-[var(--color-ink-soft)]">
    A régi oldal erőssége a saját tapasztalat és a saját fotók volt — ezt vittük tovább.
  </p>
  <ul class="mt-10 grid gap-8 md:grid-cols-2">
    {
      quotes.map((q) => (
        <li class="border-t border-[var(--color-line)] pt-6">
          <blockquote class="font-display text-xl font-medium leading-snug text-[var(--color-ink)]">
            „{q.text}”
          </blockquote>
          <p class="mt-4 text-sm text-[var(--color-ink-soft)]">
            <span class="font-semibold text-[var(--color-ink)]">{q.who}</span> · {q.role}
          </p>
        </li>
      ))
    }
  </ul>
  <dl class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
    <div>
      <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Tapasztalat</dt>
      <dd class="mt-1 font-display text-3xl font-bold">10+ év</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Lakossági</dt>
      <dd class="mt-1 font-display text-3xl font-bold">300+</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Céges</dt>
      <dd class="mt-1 font-display text-3xl font-bold">több tucat</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">Nagyobb rendszerek</dt>
      <dd class="mt-1 font-display text-3xl font-bold">50 kW+</dd>
    </div>
  </dl>
</section>
