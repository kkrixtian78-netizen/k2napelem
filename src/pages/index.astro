---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import GrantBanner from '../components/GrantBanner.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="K2Napelem — napelem és villanyszerelés"
  description="Napelemes rendszerek, hibrid energiatárolás, villanyszerelés, fűtés és pályázatírás Pócsmegyerről. Kalkulátor és egyszerű bolt. +36 30 2677 665."
  ogImage="/images/hero-roof.jpeg"
  canonicalPath="/"
>
  <GrantBanner />
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src="/images/hero-roof.webp"
        alt="Saját kivitelezésű napelemes tető"
        class="kenburns h-full w-full object-cover object-center"
        width="1920"
        height="960"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(28,42,48,0.78)_0%,rgba(28,42,48,0.48)_52%,rgba(28,42,48,0.22)_100%)]"></div>
    </div>

    <div class="mx-auto flex min-h-[22rem] max-w-6xl flex-col justify-end px-4 pb-10 pt-16 sm:min-h-[26rem] sm:px-6 sm:pb-12 sm:pt-20 md:min-h-[28rem]">
      <div class="reveal flex items-center gap-3">
        <img
          src="/images/brand/k2-mark.webp"
          alt=""
          width="56"
          height="56"
          class="h-11 w-11 sm:h-12 sm:w-12"
        />
        <p class="font-brand text-3xl text-white sm:text-4xl">
          {site.name}
        </p>
      </div>
      <h1 class="reveal reveal-delay-1 mt-5 max-w-3xl text-balance font-display text-3xl font-bold text-white sm:text-4xl md:text-[2.75rem]">
        Saját áram a tetőről!
      </h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-base leading-relaxed text-white/88 sm:text-lg">
        Napelemes rendszerek, energiatárolás, villanyszerelés A–Z-ig, elektromos fűtési rendszerek, elektromos kapuk —
        minden ami elektromos — teljes kivitelezéssel, felméréstől a kész átadásig — egy kézből!
      </p>
      <div class="reveal reveal-delay-3 mt-7 flex flex-wrap gap-3">
        <a
          href="/kalkulator"
          class="rounded-md bg-[var(--color-sun)] px-5 py-3 text-sm font-semibold text-white no-underline transition hover:bg-[var(--color-sun-deep)]"
        >
          Napelem kalkulátor
        </a>
        <a
          href="/kapcsolat#ajanlat"
          class="rounded-md border border-white/35 bg-white/10 px-5 py-3 text-sm font-semibold text-white no-underline backdrop-blur-sm transition hover:bg-white/20"
        >
          Árajánlatot kérek
        </a>
      </div>
    </div>
  </section>

  <!-- Clear path: 3 next steps -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/kalkulator" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <h2 class="font-display text-2xl font-bold">Kalkulátor</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Számold ki most, mennyibe kerülne a te rendszered! (Becsült árak!)</p>
      </a>
      <a href="/szolgaltatasok" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <h2 class="font-display text-2xl font-bold">Szolgáltatások</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Minden amivel foglalkozunk!</p>
      </a>
      <a href="/bolt" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <h2 class="font-display text-2xl font-bold">Bolt</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Ha csak néhány összetevőre van szükséged, nem egy egész rendszerre — érdeklődés egy kattintással.</p>
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden border-y border-[var(--color-line)] bg-[linear-gradient(135deg,color-mix(in_oklab,var(--color-sun)_18%,white)_0%,color-mix(in_oklab,var(--color-sky)_14%,white)_100%)]">
    <div class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[color-mix(in_oklab,var(--color-sun)_22%,transparent)] blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-10 h-64 w-64 rounded-full bg-[color-mix(in_oklab,var(--color-sky)_20%,transparent)] blur-3xl"></div>
    <div class="relative mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:px-6 md:flex-row md:items-end md:justify-between md:py-14">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-sun-deep)]">Támogatás</p>
        <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Pályázati lehetőségek</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--color-ink-soft)] sm:text-lg">
          OETP energiatároló támogatás és a nem sokára induló Wekerle+ energetikai felújítás — egy helyen, érthetően.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-[var(--color-ink)]">
          <a href="/otthoni-energiatarolo" class="no-underline hover:text-[var(--color-sun-deep)]">OETP részletek →</a>
          <a href="/palyazati-lehetosegek#wekerle" class="no-underline hover:text-[var(--color-sun-deep)]">Wekerle+ →</a>
        </div>
      </div>
      <a
        href="/palyazati-lehetosegek"
        class="inline-flex shrink-0 items-center justify-center rounded-md bg-[var(--color-sun)] px-6 py-3.5 text-sm font-semibold text-white no-underline transition hover:bg-[var(--color-sun-deep)]"
      >
        Megnézem a pályázatokat
      </a>
    </div>
  </section>

  <TrustStrip />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 sm:px-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Miért a K2Napelem?</h2>
      <p class="mt-4 text-[var(--color-ink-soft)]">
        15+ év a napelemes szakmában — előbb nagy cégnél, majd saját vállalkozásként.
        Kollégáinkkal több száz lakossági és céges rendszeren vagyunk túl, hiba nélküli átadásokkal és továbbajánlásokkal.
      </p>
      <a href="/rolunk" class="mt-8 inline-flex text-sm font-semibold text-[var(--color-sky-deep)]">Rólunk bővebben</a>
    </div>
    <div class="mx-auto w-full max-w-sm overflow-hidden rounded-xl lg:mx-0 lg:justify-self-end">
      <img
        src="/images/services/handover.webp"
        alt="Napelemes rendszer átadása az ügyfélnek"
        class="aspect-[4/3] w-full object-cover"
        loading="lazy"
        width="600"
        height="450"
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-24 pt-12 sm:px-6">
    <QuoteForm />
  </section>
</BaseLayout>
