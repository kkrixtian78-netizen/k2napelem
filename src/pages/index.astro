---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { gallery, services, site } from '../data/site';
const previewGallery = gallery.slice(0, 6);
---

<BaseLayout
  title="K2Napelem — napelem és villanyszerelés"
  description="Napelemes rendszerek, hibrid energiatárolás, villanyszerelés és pályázatírás Pócsmegyerről. Kérjen árajánlatot: +36 30 2677 665."
  ogImage="/images/hero-roof.jpeg"
  canonicalPath="/"
>
  <!-- Hero: one composition — brand + headline + sentence + CTAs + full-bleed image -->
  <section class="relative isolate min-h-[100svh] overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src="/images/hero-roof.webp"
        alt="Saját kivitelezésű napelemes tető"
        class="kenburns h-full w-full object-cover"
        width="1920"
        height="960"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 bg-[linear-gradient(105deg,rgba(28,42,48,0.78)_0%,rgba(28,42,48,0.42)_48%,rgba(28,42,48,0.18)_100%)]"
      >
      </div>
    </div>

    <div class="mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-4 pb-16 pt-28 sm:px-6 sm:pb-20">
      <p class="reveal font-display text-5xl font-extrabold tracking-tight text-white sm:text-6xl md:text-7xl">
        {site.name}
      </p>
      <h1 class="reveal reveal-delay-1 mt-5 max-w-3xl text-balance font-display text-3xl font-bold text-white sm:text-4xl md:text-5xl">
        Saját áram a tetőről — felméréstől a kész rendszerig.
      </h1>
      <p class="reveal reveal-delay-2 mt-5 max-w-xl text-lg text-white/85">
        Napelem, hibrid tárolás, villanyszerelés és pályázat — 10+ év tapasztalattal, saját fotókkal a munkáinkról.
      </p>
      <div class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-3">
        <a
          href="/kapcsolat#ajanlat"
          class="rounded-md bg-[var(--color-sun)] px-5 py-3 text-sm font-semibold text-white no-underline transition hover:bg-[var(--color-sun-deep)]"
        >
          Árajánlatot kérek
        </a>
        <a
          href={site.phoneHref}
          class="rounded-md border border-white/35 bg-white/10 px-5 py-3 text-sm font-semibold text-white no-underline backdrop-blur-sm transition hover:bg-white/20"
        >
          {site.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Szolgáltatásaink</h2>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Egy partner a teljes energetikai úton: tervezés, engedélyeztetés, kivitelezés, pályázat.
      </p>
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((item) => (
          <li>
            <a href={item.href} class="group block no-underline">
              <div class="overflow-hidden rounded-xl">
                <img
                  src={item.image}
                  alt=""
                  class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-4 font-display text-xl font-bold group-hover:text-[var(--color-sky-deep)]">{item.title}</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{item.lead}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="soft-divider mx-auto max-w-6xl"></div>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Miért a K2Napelem?</h2>
      <p class="mt-4 text-[var(--color-ink-soft)]">
        Közel tíz éve a napelemes szakmában — előbb nagy cégnél, majd saját vállalkozásként.
        Kollégáinkkal több száz lakossági és céges rendszeren vagyunk túl, hiba nélküli átadásokkal és továbbajánlásokkal.
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3">
        <div>
          <dt class="text-sm text-[var(--color-ink-soft)]">Tapasztalat</dt>
          <dd class="mt-1 font-display text-3xl font-bold">10+ év</dd>
        </div>
        <div>
          <dt class="text-sm text-[var(--color-ink-soft)]">Lakossági rendszer</dt>
          <dd class="mt-1 font-display text-3xl font-bold">300+</dd>
        </div>
        <div>
          <dt class="text-sm text-[var(--color-ink-soft)]">Székhely</dt>
          <dd class="mt-1 font-display text-3xl font-bold">Pócsmegyer</dd>
        </div>
      </dl>
      <a href="/rolunk" class="mt-8 inline-flex text-sm font-semibold text-[var(--color-sky-deep)]">Rólunk bővebben</a>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <img
        src="/images/services/about.webp"
        alt="K2Napelem kivitelezés a tetőn"
        class="aspect-[4/5] w-full object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <section class="bg-[color-mix(in_oklab,var(--color-mist)_65%,transparent)] py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">Munkáink</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">Saját készítésű fotók a saját telepítéseinkről.</p>
        </div>
        <a href="/munkaink" class="text-sm font-semibold text-[var(--color-sky-deep)]">Teljes galéria</a>
      </div>
      <div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
        {
          previewGallery.map((photo) => (
            <img
              src={photo.src}
              alt={photo.alt}
              class="mb-4 w-full break-inside-avoid rounded-xl"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Pályázati segítség</h2>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Az Otthoni Energiatároló Program keretében akár 2 500 000 Ft vissza nem térítendő támogatás érhető el.
        Segítünk eligazodni a feltételekben és a kivitelezésben.
      </p>
      <a
        href="/otthoni-energiatarolo"
        class="mt-6 inline-flex rounded-md border border-[var(--color-line)] bg-white/70 px-4 py-2.5 text-sm font-semibold no-underline hover:bg-white"
      >
        Program részletei
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
    <QuoteForm />
  </section>
</BaseLayout>
