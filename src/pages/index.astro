---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import GrantBanner from '../components/GrantBanner.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { gallery, services, site } from '../data/site';
import { formatHuf, products } from '../data/products';

const previewGallery = gallery.slice(0, 6);
const shopPreview = products.filter((p) => p.category === 'futes').slice(0, 3);
const homeServices = services.slice(0, 4);
---

<BaseLayout
  title="K2Napelem — napelem és villanyszerelés"
  description="Napelemes rendszerek, hibrid energiatárolás, villanyszerelés, fűtés és pályázatírás Pócsmegyerről. Kalkulátor és egyszerű bolt. +36 30 2677 665."
  ogImage="/images/hero-roof.jpeg"
  canonicalPath="/"
>
  <GrantBanner />
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src="/images/hero-roof.webp"
        alt="Saját kivitelezésű napelemes tető"
        class="kenburns h-full w-full object-cover object-center"
        width="1920"
        height="960"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(28,42,48,0.78)_0%,rgba(28,42,48,0.48)_52%,rgba(28,42,48,0.22)_100%)]"></div>
    </div>

    <div class="mx-auto flex min-h-[22rem] max-w-6xl flex-col justify-end px-4 pb-10 pt-16 sm:min-h-[26rem] sm:px-6 sm:pb-12 sm:pt-20 md:min-h-[28rem]">
      <div class="reveal flex items-center gap-3">
        <img
          src="/images/brand/k2-mark.webp"
          alt=""
          width="56"
          height="56"
          class="h-11 w-11 sm:h-12 sm:w-12"
        />
        <p class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {site.name}
        </p>
      </div>
      <h1 class="reveal reveal-delay-1 mt-5 max-w-3xl text-balance font-display text-3xl font-bold text-white sm:text-4xl md:text-[2.75rem]">
        Saját áram a tetőről!
      </h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-base leading-relaxed text-white/88 sm:text-lg">
        Napelemes rendszerek, energiatárolás, villanyszerelés A–Z-ig, elektromos fűtési rendszerek, elektromos kapuk —
        minden ami elektromos — teljes kivitelezéssel, felméréstől a kész átadásig — egy kézből!
      </p>
      <div class="reveal reveal-delay-3 mt-7 flex flex-wrap gap-3">
        <a
          href="/kalkulator"
          class="rounded-md bg-[var(--color-sun)] px-5 py-3 text-sm font-semibold text-white no-underline transition hover:bg-[var(--color-sun-deep)]"
        >
          Napelem kalkulátor
        </a>
        <a
          href="/kapcsolat#ajanlat"
          class="rounded-md border border-white/35 bg-white/10 px-5 py-3 text-sm font-semibold text-white no-underline backdrop-blur-sm transition hover:bg-white/20"
        >
          Árajánlatot kérek
        </a>
      </div>
    </div>
  </section>

  <!-- Clear path: 3 next steps -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/kalkulator" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sun-deep)]">01</p>
        <h2 class="mt-3 font-display text-2xl font-bold">Kalkulátor</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Becsült méret, panelszám és ársáv a havi számlából.</p>
      </a>
      <a href="/szolgaltatasok" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sun-deep)]">02</p>
        <h2 class="mt-3 font-display text-2xl font-bold">Szolgáltatások</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Napelem, hibrid, villany, fűtés, pályázat — egy helyen.</p>
      </a>
      <a href="/bolt" class="rounded-2xl border border-[var(--color-line)] bg-white/70 p-6 no-underline transition hover:bg-white">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-sun-deep)]">03</p>
        <h2 class="mt-3 font-display text-2xl font-bold">Bolt</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Infrapanel, fűtőszőnyeg, okostükör — érdeklődés egy kattintással.</p>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Szolgáltatásaink</h2>
        <p class="mt-3 text-[var(--color-ink-soft)]">
          Egy partner a teljes energetikai úton: tervezés, engedélyeztetés, kivitelezés, pályázat.
        </p>
      </div>
      <a href="/szolgaltatasok" class="text-sm font-semibold text-[var(--color-sky-deep)]">Összes szolgáltatás</a>
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2">
      {
        homeServices.map((item) => (
          <li>
            <a href={item.href} class="group grid gap-5 no-underline sm:grid-cols-[0.9fr_1.1fr] sm:items-center">
              <div class="overflow-hidden rounded-xl">
                <img
                  src={item.image}
                  alt=""
                  class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div>
                <h3 class="font-display text-xl font-bold group-hover:text-[var(--color-sky-deep)]">{item.title}</h3>
                <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{item.lead}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="soft-divider mx-auto max-w-6xl"></div>

  <TrustStrip />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Miért a K2Napelem?</h2>
      <p class="mt-4 text-[var(--color-ink-soft)]">
        Közel tíz éve a napelemes szakmában — előbb nagy cégnél, majd saját vállalkozásként.
        Kollégáinkkal több száz lakossági és céges rendszeren vagyunk túl, hiba nélküli átadásokkal és továbbajánlásokkal.
      </p>
      <a href="/rolunk" class="mt-8 inline-flex text-sm font-semibold text-[var(--color-sky-deep)]">Rólunk bővebben</a>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <img
        src="/images/services/about.webp"
        alt="K2Napelem kivitelezés a tetőn"
        class="aspect-[4/5] w-full object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <section class="bg-[color-mix(in_oklab,var(--color-mist)_65%,transparent)] py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">Bolt — fűtési válogatás</h2>
          <p class="mt-3 text-[var(--color-ink-soft)]">A régi oldal termékáraival, egyszerű érdeklődési listával.</p>
        </div>
        <a href="/bolt" class="text-sm font-semibold text-[var(--color-sky-deep)]">Teljes bolt</a>
      </div>
      <ul class="mt-10 grid gap-8 sm:grid-cols-3">
        {
          shopPreview.map((p) => (
            <li>
              <a href={`/bolt/${p.slug}`} class="group block no-underline">
                <div class="overflow-hidden rounded-xl">
                  <img src={p.image} alt={p.name} class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
                </div>
                <h3 class="mt-4 font-display text-lg font-bold">{p.name}</h3>
                <p class="mt-1 text-sm font-semibold">{formatHuf(p.priceFrom)}-tól</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Munkáink</h2>
        <p class="mt-3 text-[var(--color-ink-soft)]">Saját készítésű fotók a saját telepítéseinkről.</p>
      </div>
      <a href="/munkaink" class="text-sm font-semibold text-[var(--color-sky-deep)]">Teljes galéria</a>
    </div>
    <div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {
        previewGallery.map((photo) => (
          <img src={photo.src} alt={photo.alt} class="mb-4 w-full break-inside-avoid rounded-xl" loading="lazy" />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Pályázati segítség</h2>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        Az Otthoni Energiatároló Program keretében akár 2 500 000 Ft vissza nem térítendő támogatás érhető el.
      </p>
      <a
        href="/otthoni-energiatarolo"
        class="mt-6 inline-flex rounded-md border border-[var(--color-line)] bg-white/70 px-4 py-2.5 text-sm font-semibold no-underline hover:bg-white"
      >
        Program részletei
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-24 pt-12 sm:px-6">
    <QuoteForm />
  </section>
</BaseLayout>
