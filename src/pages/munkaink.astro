---
import BaseLayout from '../layouts/BaseLayout.astro';
import { gallery } from '../data/site';
---

<BaseLayout
  title="Munkáink"
  description="Saját készítésű fotók a K2Napelem napelemes és energetikai kivitelezéseiről."
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-14 sm:px-6">
    <h1 class="font-display text-4xl font-bold sm:text-5xl">Munkáink</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Eddigi munkáink a teljesség igénye nélkül — az oldalon szinte kivétel nélkül saját készítésű képek láthatók.
    </p>
  </section>

  <section class="mx-auto max-w-6xl columns-1 gap-4 px-4 pb-24 sm:columns-2 sm:px-6 lg:columns-3">
    {
      gallery.map((photo) => (
        <figure class="mb-4 break-inside-avoid overflow-hidden rounded-xl">
          <img src={photo.src} alt={photo.alt} class="w-full" loading="lazy" />
        </figure>
      ))
    }
  </section>
</BaseLayout>
