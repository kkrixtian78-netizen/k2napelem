---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatHuf, productBySlug, products } from '../../data/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = productBySlug(slug!);
if (!product) {
  throw new Error(`Unknown product: ${slug}`);
}
---

<BaseLayout
  title={product.name}
  description={product.short}
  ogImage={product.image}
>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:items-start">
    <img
      src={product.image}
      alt={product.name}
      class="aspect-square w-full rounded-2xl object-cover"
    />
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-sky-deep)]">
        {product.category === 'napelem'
          ? 'Napelemes rendszerhez'
          : product.category === 'ev'
            ? 'EV töltők'
            : 'Fűtés'}
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold">{product.name}</h1>
      <p class="mt-4 text-2xl font-semibold">
        {
          product.priceTo
            ? `${formatHuf(product.priceFrom)} – ${formatHuf(product.priceTo)}`
            : `${formatHuf(product.priceFrom)}-tól`
        }
      </p>
      <p class="mt-4 text-[var(--color-ink-soft)]">{product.description}</p>
      <ul class="mt-6 space-y-2 text-sm text-[var(--color-ink-soft)]">
        {product.highlights.map((h) => <li>— {h}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <button
          type="button"
          class="rounded-md bg-[var(--color-sun)] px-5 py-3 text-sm font-semibold text-white"
          data-add-to-inquiry
          data-id={product.id}
          data-name={product.name}
          data-price={product.priceFrom}
        >
          Érdeklődéshez adom
        </button>
        <a href="/bolt" class="rounded-md border border-[var(--color-line)] bg-white/70 px-5 py-3 text-sm font-semibold no-underline">
          Vissza a bolthoz
        </a>
      </div>
      <p class="mt-4 text-xs text-[var(--color-ink-soft)]">
        Az árak tájékoztató jellegűek, a készlet és a forgalmazói ár változhat. Telepítés külön egyeztethető.
      </p>
    </div>
  </section>

  <!-- Shared cart UI (minimal) -->
  <div class="fixed bottom-4 right-4 z-40" data-inquiry-root>
    <div
      class="mb-3 hidden w-[min(22rem,calc(100vw-2rem))] rounded-xl border border-[var(--color-line)] bg-white p-4"
      data-inquiry-panel
      hidden
    >
      <div class="flex items-center justify-between">
        <p class="font-display text-lg font-bold">Érdeklődési lista</p>
        <button type="button" class="text-sm font-semibold" data-inquiry-close>Bezár</button>
      </div>
      <ul class="mt-3 max-h-56 space-y-2 overflow-auto text-sm" data-inquiry-list></ul>
      <p class="mt-3 text-sm font-semibold" data-inquiry-total></p>
      <button type="button" class="mt-4 w-full rounded-md bg-[var(--color-sun)] px-3 py-2.5 text-sm font-semibold text-white" data-inquiry-send>
        Küldés e-mailben
      </button>
    </div>
    <button type="button" class="rounded-md bg-[var(--color-ink)] px-4 py-3 text-sm font-semibold text-white" data-inquiry-toggle>
      Lista (<span data-inquiry-count>0</span>)
    </button>
  </div>

  <script>
    const KEY = 'k2-inquiry-cart';
    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '[]');
      } catch {
        return [];
      }
    };
    const write = (items) => localStorage.setItem(KEY, JSON.stringify(items));
    const fmt = (n) =>
      new Intl.NumberFormat('hu-HU', { style: 'currency', currency: 'HUF', maximumFractionDigits: 0 }).format(n);

    const panel = document.querySelector('[data-inquiry-panel]');
    const list = document.querySelector('[data-inquiry-list]');
    const total = document.querySelector('[data-inquiry-total]');
    const count = document.querySelector('[data-inquiry-count]');

    const render = () => {
      const items = read();
      if (count) count.textContent = String(items.reduce((s, i) => s + i.qty, 0));
      if (total)
        total.textContent = items.length
          ? `Összesen (tájékoztató): ${fmt(items.reduce((s, i) => s + i.price * i.qty, 0))}`
          : '';
      if (list) {
        list.innerHTML = items.length
          ? items
              .map(
                (i) =>
                  `<li class="flex justify-between gap-3 border-b border-[var(--color-line)] pb-2"><span>${i.qty}× ${i.name}</span><button type="button" data-remove="${i.id}" class="text-xs font-semibold text-[var(--color-sun-deep)]">törlés</button></li>`,
              )
              .join('')
          : '<li>A lista üres.</li>';
      }
    };

    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const addBtn = t.closest('[data-add-to-inquiry]');
      if (addBtn instanceof HTMLElement) {
        const items = read();
        const id = addBtn.dataset.id || '';
        const existing = items.find((i) => i.id === id);
        if (existing) existing.qty += 1;
        else
          items.push({
            id,
            name: addBtn.dataset.name || '',
            price: Number(addBtn.dataset.price || 0),
            qty: 1,
          });
        write(items);
        render();
        panel?.classList.remove('hidden');
        panel?.removeAttribute('hidden');
        return;
      }
      if (t.closest('[data-inquiry-toggle]')) {
        const open = panel?.hasAttribute('hidden');
        if (open) {
          panel?.removeAttribute('hidden');
          panel?.classList.remove('hidden');
        } else {
          panel?.setAttribute('hidden', '');
          panel?.classList.add('hidden');
        }
        return;
      }
      if (t.closest('[data-inquiry-close]')) {
        panel?.setAttribute('hidden', '');
        panel?.classList.add('hidden');
        return;
      }
      const remove = t.closest('[data-remove]');
      if (remove) {
        write(read().filter((i) => i.id !== remove.getAttribute('data-remove')));
        render();
        return;
      }
      if (t.closest('[data-inquiry-send]')) {
        const items = read();
        if (!items.length) return;
        const body = [
          'Érdeklődés a K2Napelem boltból:',
          '',
          ...items.map((i) => `- ${i.qty}× ${i.name}`),
          '',
          'Kérem, visszahívást / árajánlatot.',
        ].join('\n');
        window.location.href = `mailto:k2@k2napelem.hu?subject=${encodeURIComponent('Bolt érdeklődés — k2napelem.hu')}&body=${encodeURIComponent(body)}`;
      }
    });

    render();
  </script>
</BaseLayout>
