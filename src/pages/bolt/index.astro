---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ShopApp from '../../components/ShopApp.astro';
---

<BaseLayout
  title="Bolt"
  description="Egyszerű K2Napelem webshop: infrapanel, fűtőszőnyeg, okostükör és tájékoztató napelem csomagok. Érdeklődés e-mailben."
>
  <PageHero
    eyebrow="Egyszerű webshop"
    title="Bolt"
    lead="Fűtési termékek és tájékoztató napelem-csomagok a régi kínálat áraival. Nincs online fizetés — tegye a listára, amit érdekel, és küldje el egy kattintással."
  />

  <section class="mx-auto max-w-6xl px-4 pb-28 sm:px-6">
    <ShopApp />
  </section>
</BaseLayout>
