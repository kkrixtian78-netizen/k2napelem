---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import PageHero from '../components/PageHero.astro';
import { gallery } from '../data/site';

const steps = [
  { title: 'Érdeklődés', text: 'Felmerülő kérdéseire szívesen válaszolunk — hívjon vagy írjon.' },
  { title: 'Felmérés', text: 'Helyszínen megnézzük a tetőt/területet, a hálózatot és az igényeket.' },
  { title: 'Árajánlat', text: '1–2 napon belül pontos kalkulációt küldünk, amit együtt átbeszélünk.' },
  { title: 'Szerződés', text: 'Egyeztetés után szerződéstervezet, majd közös aláírás.' },
  { title: 'Engedélyeztetés', text: 'Igénybejelentés, MGT, csatlakozási dokumentáció — végigkísérjük.' },
  { title: 'Kivitelezés', text: 'Egyeztetett időpontban megépítjük a rendszert (családi háznál gyakran 1 nap).' },
  { title: 'Átadás', text: 'Próbaüzem, jegyzőkönyvek, végszámla, készre jelentés a szolgáltatónál.' },
  { title: 'Üzembe helyezés', text: 'A szolgáltató alvállalkozója kapcsolja be — ettől termel a rendszer.' },
];

/** 2×3 montázs — teljes téglalap, minden cella kitöltve */
const montage = [
  gallery[0],
  gallery[11],
  gallery[15],
  gallery[7],
  gallery[16],
  gallery[4],
] as const;
---

<BaseLayout
  title="Napelemes rendszerek"
  description="Napelemes rendszerek teljes kivitelezése: felmérés, engedélyeztetés, telepítés tetőre vagy földre. K2Napelem, Pócsmegyer."
>
  <PageHero
    eyebrow="Szolgáltatás"
    title="Napelemes rendszerek"
    lead="Az érdeklődéstől az átadásig. Vállalunk földre és szinte bármilyen héjazatú tetőre telepítést is — teljes ügyintézéssel, akár pályázattal."
  />

  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-label="Saját kivitelezések montázsa">
    <div class="mx-auto aspect-[21/9] max-w-5xl overflow-hidden rounded-2xl">
      <div class="grid h-full w-full grid-cols-3 grid-rows-2 gap-1 sm:gap-1.5">
        {
          montage.map((photo, i) => (
            <figure class="relative m-0 min-h-0 overflow-hidden bg-[var(--color-mist)]">
              <img
                src={photo.src}
                alt={photo.alt}
                class="absolute inset-0 h-full w-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
                width="600"
                height="600"
              />
            </figure>
          ))
        }
      </div>
    </div>
    <p class="mt-3 text-right text-sm text-[var(--color-ink-soft)]">
      <a href="/munkaink" class="font-semibold text-[var(--color-sky-deep)]">Több saját munka →</a>
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-bold">A kivitelezés menete</h2>
      <a href="/kalkulator" class="text-sm font-semibold text-[var(--color-sky-deep)]">Előtte: kalkulátor →</a>
    </div>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        steps.map((step, i) => (
          <li class="border-t border-[var(--color-line)] pt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-sun-deep)]">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-2 font-display text-xl font-bold">{step.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="megterules" class="scroll-mt-24 bg-[color-mix(in_oklab,var(--color-mist)_60%,transparent)] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Megtérülés — amit érdemes tudni</h2>
        <p class="mt-4 text-lg text-[var(--color-ink-soft)]">
          Sokan e körül döntenek. A megtérülés nem egyetlen varázsszám: azt mutatja, hány év alatt
          hozza vissza a beruházást a megspórolt (és saját célra felhasznált) áram.
        </p>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="font-display text-xl font-bold">Mitől függ?</h3>
          <ul class="mt-4 space-y-3 text-[var(--color-ink-soft)]">
            <li>
              <strong class="text-[var(--color-ink)]">Fogyasztás és szokások</strong> —
              minél többet használ fel nappal a saját termelésből, annál gyorsabb a megtérülés.
            </li>
            <li>
              <strong class="text-[var(--color-ink)]">Tájolás és dőlésszög</strong> —
              a dél a legkedvezőbb; kelet–nyugat és árnyék csökkenti a hozamot.
            </li>
            <li>
              <strong class="text-[var(--color-ink)]">Elszámolási mód</strong> —
              a bruttó elszámolásnál a hálózatba feltolt áram értéke alacsonyabb, ezért a saját felhasználás a kulcs.
            </li>
            <li>
              <strong class="text-[var(--color-ink)]">Energiaárak</strong> —
              ha a villany drágul, a megspórolt kWh többet ér — a megtérülés rövidülhet.
            </li>
            <li>
              <strong class="text-[var(--color-ink)]">Rendszer típusa</strong> —
              hagyományos hálózatos vs. hibrid + tároló: más beruházás, más hosszú távú egyenleg.
            </li>
            <li>
              <strong class="text-[var(--color-ink)]">Támogatás / pályázat</strong> —
              az OETP vagy más támogatás jelentősen csökkentheti a saját részt, így a megtérülést is.
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-display text-xl font-bold">Orientáló sávok</h3>
          <p class="mt-4 text-[var(--color-ink-soft)]">
            <strong class="text-[var(--color-ink)]">Hagyományos hálózatos rendszer:</strong>
            jó tájolás és reális méretezés mellett gyakran
            <strong class="text-[var(--color-ink)]">kb. 8–10 év</strong> körüli sávról beszélünk.
            A panelek 20–25+ évig termelnek — a megtérülés után a rendszer jellemzően tovább „termeli” a megtakarítást.
          </p>
          <p class="mt-4 text-[var(--color-ink-soft)]">
            <strong class="text-[var(--color-ink)]">Hibrid + energiatároló:</strong>
            a beruházás nagyobb, ezért a szimpla megtérülési idő hosszabb lehet.
            Cserébe több saját áramot használ fel (este is), kevésbé függ a hálózati elszámolástól,
            és vészhelyzetben is adhat ellátást. Sok ügyfélnél ez a hosszú távú biztonság és a
            saját felhasználás aránya miatt éri meg.
          </p>
          <p class="mt-4 text-[var(--color-ink-soft)]">
            <strong class="text-[var(--color-ink)]">Példa:</strong>
            ha a havi villany + fűtés áram kb. 60&nbsp;000&nbsp;Ft, a kiváltáshoz tipikusan ~10&nbsp;kWp kell
            (~24 panel, ~52&nbsp;m²). A pontos árat és megtérülést a kalkulátor és a helyszíni felmérés adja.
          </p>
        </div>
      </div>

      <div class="mt-12 max-w-3xl border-t border-[var(--color-line)] pt-8">
        <h3 class="font-display text-xl font-bold">Hogyan számoljunk okosan?</h3>
        <p class="mt-3 text-[var(--color-ink-soft)]">
          Ne csak a „hány év” kérdésre figyeljen. Nézze meg a
          <strong class="text-[var(--color-ink)]">25 éves életciklust</strong>:
          megtérülés után még sok év termelés jöhet; a villanyszámla-védelem és az energiafüggetlenség
          is érték. A kalkulátorunk tájékoztató számot ad — a döntéshez személyre szabott ajánlat kell.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/kalkulator"
            class="inline-flex rounded-md bg-[var(--color-sun)] px-4 py-2.5 text-sm font-semibold text-white no-underline hover:bg-[var(--color-sun-deep)]"
          >
            Saját számítás a kalkulátorban
          </a>
          <a
            href="/palyazati-lehetosegek"
            class="inline-flex rounded-md border border-[var(--color-line)] bg-white/70 px-4 py-2.5 text-sm font-semibold no-underline hover:bg-white"
          >
            Pályázati lehetőségek
          </a>
          <a
            href="/kapcsolat#ajanlat"
            class="inline-flex rounded-md border border-[var(--color-line)] bg-white/70 px-4 py-2.5 text-sm font-semibold no-underline hover:bg-white"
          >
            Egyedi ajánlatot kérek
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <QuoteForm heading="Érdekel a napelem?" intro="Írja meg a települését és durván a havi fogyasztását — visszahívjuk." />
  </section>
</BaseLayout>
