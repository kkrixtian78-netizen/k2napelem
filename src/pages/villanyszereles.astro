---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<BaseLayout
  title="Villanyszerelés"
  description="Épületek villamos hálózata, mérőhely, felújítás, hibakeresés. Tapasztalt villanyszerelés korrekt áron — K2Napelem."
>
  <section class="mx-auto max-w-6xl px-4 pb-10 pt-14 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-sky-deep)]">Szolgáltatás</p>
    <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">Villanyszerelés</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Épületek villamos hálózatának kiépítése, mérőhely kialakítás, régi vezetékek cseréje, felújítás, hibakeresés és javítás — A-tól Z-ig.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <img
      src="/images/services/electrical.webp"
      alt="Villanyszerelési munka"
      class="max-h-[28rem] w-full rounded-2xl object-cover"
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-3xl font-bold">Orientáló árak</h2>
    <p class="mt-3 max-w-2xl text-sm text-[var(--color-ink-soft)]">
      Az alábbi sávok tájékoztató jellegűek; a végösszeg a helyszíntől, anyagoktól és a munka jellegétől függ.
    </p>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="border-t border-[var(--color-line)] pt-4">
        <dt class="font-semibold">Átlagos tartomány</dt>
        <dd class="mt-2 text-sm text-[var(--color-ink-soft)]">8.000–15.000 Ft/m² (anyaggal, szerelvények nélkül) + biztosítéktábla</dd>
      </div>
      <div class="border-t border-[var(--color-line)] pt-4">
        <dt class="font-semibold">Újépítés</dt>
        <dd class="mt-2 text-sm text-[var(--color-ink-soft)]">kb. 6.000–9.000 Ft/m² (anyag/kiszállás/bontás nélkül)</dd>
      </div>
      <div class="border-t border-[var(--color-line)] pt-4">
        <dt class="font-semibold">Családi ház</dt>
        <dd class="mt-2 text-sm text-[var(--color-ink-soft)]">kb. 7.000–9.000 Ft/m²</dd>
      </div>
      <div class="border-t border-[var(--color-line)] pt-4">
        <dt class="font-semibold">Hibakeresés</dt>
        <dd class="mt-2 text-sm text-[var(--color-ink-soft)]">10–15.000 Ft/óra + kiszállás + javítás</dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
    <QuoteForm heading="Villanyszerelés érdekel?" />
  </section>
</BaseLayout>
